rules_version = '2';

// Reglas de Firestore de Domus Deco. Son la «seguridad de verdad» de los datos:
// el navegador de cualquier persona puede hablar con Firestore, así que lo que no
// permiten estas reglas no se puede hacer, sin importar lo que diga la app.
// Todo lo que no está escrito acá queda prohibido (ver la última regla).
//
// Cómo probarlas antes de publicar: SEGURIDAD.md, punto 10 (simulador de reglas de la consola).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Administrador/a = tiene un documento en admins/{su UID}. Ese documento solo se crea a mano desde la consola.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function textOrEmpty(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Productos: los ve cualquiera, solo administración los cambia ----------
    function validProduct(p) {
      return p.keys().hasOnly(['id', 'slug', 'name', 'brand', 'category', 'price', 'stock', 'image', 'imageAlt',
                               'description', 'sizes', 'colors', 'active', 'custom'])
        && p.keys().hasAll(['name', 'category', 'price', 'image'])
        && text(p.name, 100)
        && textOrEmpty(p.get('brand', ''), 60)
        && text(p.category, 40)
        && p.price is int && p.price > 0 && p.price < 100000000
        && (!('stock' in p) || (p.stock is int && p.stock >= 0 && p.stock < 100000))
        && text(p.image, 700000)
        && textOrEmpty(p.get('imageAlt', ''), 200)
        && textOrEmpty(p.get('description', ''), 2000)
        && p.get('sizes', []) is list && p.get('sizes', []).size() <= 30
        && p.get('colors', []) is list && p.get('colors', []).size() <= 30
        && p.get('active', true) is bool;
    }
    match /products/{id} {
      // Los productos ocultos (active == false) se filtran en la app, no acá: el catálogo no tiene datos privados.
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Pedidos: cada persona ve solo los suyos ----------
    function validOrder(o) {
      return o.keys().hasOnly(['userId', 'number', 'status', 'items', 'total', 'customer', 'createdAt'])
        && o.keys().hasAll(['userId', 'status', 'items', 'total', 'customer'])
        && o.userId == request.auth.uid
        && o.status == 'pendiente'
        && o.items is list && o.items.size() > 0 && o.items.size() <= 50
        && o.total is number && o.total >= 0 && o.total < 1000000000
        && o.customer is map
        && o.customer.keys().hasOnly(['name', 'email', 'phone', 'address'])
        && textOrEmpty(o.customer.get('name', ''), 100)
        && textOrEmpty(o.customer.get('email', ''), 254);
    }
    match /orders/{id} {
      allow create: if signedIn() && validOrder(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // El cliente nunca cambia ni borra un pedido. Solo administración (y, más adelante, el webhook de Mercado Pago, que no pasa por estas reglas).
      allow update, delete: if isAdmin();
    }

    // ---------- Perfil: cada persona, solo el suyo ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'updatedAt'])
        && (request.resource.data.get('email', null) == null || text(request.resource.data.email, 254))
        && textOrEmpty(request.resource.data.get('name', ''), 80);
      allow delete: if false;
    }

    // ---------- Carrito guardado en la cuenta ----------
    match /carts/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.get('items', []) is list
        && request.resource.data.get('items', []).size() <= 100;
      allow delete: if isOwner(uid);
    }

    // ---------- Administración: nadie se hace administrador desde el sitio ----------
    match /admins/{uid} {
      allow read: if isOwner(uid);   // solo para saber si uno mismo es admin
      allow write: if false;         // se crean a mano desde la consola de Firebase
    }

    // ---------- Todo lo demás, prohibido ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
