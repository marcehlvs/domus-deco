# Copiá este archivo como .env.local y completá con los datos de tu proyecto (Firebase → Configuración del proyecto → Tus apps).
# .env.local NO se sube a GitHub. Estos valores identifican tu proyecto pero no son secretos: la seguridad la dan las reglas de Firestore y App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (opcional, recomendado): clave de sitio PÚBLICA de reCAPTCHA v3. La clave secreta va solo en la consola de Firebase, nunca acá.
VITE_RECAPTCHA_SITE_KEY=

# Dirección pública del sitio (opcional). Sirve para las vistas previas al compartir y el sitemap.
# Si la dejás vacía se usa https://<VITE_FIREBASE_PROJECT_ID>.web.app. Completala el día que tengas dominio propio.
VITE_SITE_URL=
