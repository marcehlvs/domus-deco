rules_version = '2';

// Reglas de Firestore de Domus Deco. Son la «seguridad de verdad» de los datos:
// el navegador de cualquier persona puede hablar con Firestore, así que lo que no
// permiten estas reglas no se puede hacer, sin importar lo que diga la app.
// Todo lo que no está escrito acá queda prohibido (ver la última regla).
//
// Cómo probarlas antes de publicar: SEGURIDAD.md, punto 10 (simulador de reglas de la consola).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Administrador/a = tiene un documento en admins/{su UID}. Ese documento solo se crea a mano desde la consola.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function textOrEmpty(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------- Productos: los ve cualquiera, solo administración los cambia ----------
    function validProduct(p) {
      return p.keys().hasOnly(['id', 'slug', 'name', 'brand', 'category', 'price', 'discount', 'stock', 'image', 'imageAlt',
                               'description', 'sizes', 'colors', 'active', 'custom', 'stockBy', 'extraPhotos', 'fullImage', 'imageColor'])
        && p.keys().hasAll(['name', 'category', 'price', 'image'])
        && text(p.name, 100)
        && textOrEmpty(p.get('brand', ''), 60)
        && text(p.category, 40)
        && p.price is int && p.price > 0 && p.price < 100000000
        && (!('discount' in p) || (p.discount is int && p.discount >= 1 && p.discount <= 90))
        && (!('stock' in p) || (p.stock is int && p.stock >= 0 && p.stock < 100000))
        // Stock por medida y color: mapa «medida|color» → unidades. Cada valor se cuida desde el panel (las reglas no pueden recorrer un mapa).
        && (!('stockBy' in p) || (p.stockBy is map && p.stockBy.size() <= 900))
        // `image` es la miniatura (~480 px) cuando fullImage == true; la foto grande vive en products/{id}/photos/main.
        && text(p.image, 700000)
        && (!('fullImage' in p) || p.fullImage is bool)
        // Color de la paleta que muestra la foto principal (que coincida con una de `colors` lo cuida el panel).
        && (!('imageColor' in p) || text(p.imageColor, 40))
        // Cuántas fotos extra tiene (viven en products/{id}/photos; ver más abajo).
        && (!('extraPhotos' in p) || (p.extraPhotos is int && p.extraPhotos >= 1 && p.extraPhotos <= 4))
        && textOrEmpty(p.get('imageAlt', ''), 200)
        && textOrEmpty(p.get('description', ''), 2000)
        && p.get('sizes', []) is list && p.get('sizes', []).size() <= 30
        && p.get('colors', []) is list && p.get('colors', []).size() <= 30
        && p.get('active', true) is bool;
    }
    match /products/{id} {
      // Los productos ocultos (active == false) se filtran en la app, no acá: el catálogo no tiene datos privados.
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();

      // Fotos del producto que NO viajan en el listado: la grande principal (ID «main») y hasta 4 extra (IDs «1» a «4»).
      // Se leen solo en la ficha y el panel. Cada una puede indicar el color que muestra (que sea de la paleta lo cuida el panel).
      match /photos/{n} {
        allow read: if true;
        allow create, update: if isAdmin()
          && n in ['main', '1', '2', '3', '4']
          && request.resource.data.keys().hasOnly(['src', 'color'])
          && request.resource.data.keys().hasAll(['src'])
          && text(request.resource.data.src, 700000)
          && (!('color' in request.resource.data) || text(request.resource.data.color, 40));
        allow delete: if isAdmin();
      }
    }

    // ---------- Categorías: las ve cualquiera, solo administración las cambia ----------
    // El ID del documento es el «slug» (ej.: vasos-y-copas). «order» fija el lugar en la lista.
    // Que una categoría con productos no se borre lo cuida el panel; estas reglas no pueden contar productos.
    function validCategory(c) {
      return c.keys().hasOnly(['name', 'text', 'order'])
        && c.keys().hasAll(['name'])
        && text(c.name, 40)
        && textOrEmpty(c.get('text', ''), 60)
        && c.get('order', 0) is int && c.get('order', 0) >= 0 && c.get('order', 0) < 1000;
    }
    match /categories/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- Contador de pedidos: da el número «#1, #2…» ----------
    // Cualquier persona con sesión puede sumar 1 (al hacer un pedido), nunca otra cosa. No se borra ni se baja.
    match /counters/{name} {
      allow read: if signedIn() && name == 'orders';
      allow create: if signedIn() && name == 'orders'
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1;
      allow update: if signedIn() && name == 'orders'
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1;
    }

    // ---------- Pedidos: cada persona ve solo los suyos ----------
    // Se crean siempre «pendiente» y con el número del contador (getAfter mira el contador ya actualizado
    // en la misma transacción). Los precios y el total los manda el navegador: sirven para coordinar a mano
    // por WhatsApp, pero NO alcanzan para cobrar online. Antes de Mercado Pago el total se recalcula en el servidor.
    function validOrder(o) {
      return o.keys().hasOnly(['userId', 'number', 'status', 'items', 'total', 'customer', 'delivery', 'note', 'stockApplied', 'createdAt'])
        && o.keys().hasAll(['userId', 'number', 'status', 'items', 'total', 'customer', 'delivery', 'createdAt'])
        && o.userId == request.auth.uid
        && o.status == 'pendiente'
        && o.number is int && o.number > 0
        && getAfter(/databases/$(database)/documents/counters/orders).data.last == o.number
        && o.createdAt == request.time
        && o.get('stockApplied', false) == false
        && o.delivery in ['whatsapp', 'retiro']
        && textOrEmpty(o.get('note', ''), 500)
        && o.items is list && o.items.size() > 0 && o.items.size() <= 50
        && o.total is number && o.total >= 0 && o.total < 1000000000
        && o.customer is map
        && o.customer.keys().hasOnly(['name', 'email', 'phone', 'address'])
        && text(o.customer.get('name', ''), 100)
        && textOrEmpty(o.customer.get('email', ''), 254)
        && text(o.customer.get('phone', ''), 30)
        && textOrEmpty(o.customer.get('address', ''), 200);
    }
    match /orders/{id} {
      allow create: if signedIn() && validOrder(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      // El cliente nunca cambia ni borra un pedido. Solo administración (cambia el estado y el stock) y, más adelante, el webhook de Mercado Pago, que no pasa por estas reglas.
      allow update, delete: if isAdmin();
    }

    // ---------- Perfil: cada persona, solo el suyo ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'updatedAt'])
        && (request.resource.data.get('email', null) == null || text(request.resource.data.email, 254))
        && textOrEmpty(request.resource.data.get('name', ''), 80);
      allow delete: if false;
    }

    // ---------- Carrito guardado en la cuenta ----------
    match /carts/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.get('items', []) is list
        && request.resource.data.get('items', []).size() <= 100;
      allow delete: if isOwner(uid);
    }

    // ---------- Administración: nadie se hace administrador desde el sitio ----------
    match /admins/{uid} {
      allow read: if isOwner(uid);   // solo para saber si uno mismo es admin
      allow write: if false;         // se crean a mano desde la consola de Firebase
    }

    // ---------- Todo lo demás, prohibido ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
